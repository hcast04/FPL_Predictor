# fpl2 rebuild: environment and regenerable data
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.pkl
*.zip
# DATA IS NOT SOURCE. 120 files and 139 MB were tracked, of which 107 were
# scraper caches -- 81 FBref HTML pages (including Bundesliga, which this
# project never uses) and 26 Understat pickles. All of it is regenerated by
# the collectors.
# NOTE the trailing /* -- `/data/` excludes the DIRECTORY, and git never
# descends into an excluded directory, so a later `!` negation inside it is
# silently dead. That would have dropped historical_fpl.csv.gz from the repo.
/data/*
/fpl2/data/
/fixes/data/
# ... except the seed the code actually reads. `config.HISTORICAL` points
# here and nothing runs without it. 4.8 MB.
!/data/historical_fpl.csv.gz

# working caches moved in from $HOME on 2026-10-29 (505 MB of fitted panels,
# live forecasts and experiment outputs) and the soccerdata scrape cache
/data/cache/
/data/soccerdata_cache/

# the publish clone, superseded by this folder being the repo
/_publish/
/.backup_0922/
/.claude/
